
# =====  user endpoints  ======

#api call for registering or creating a user 

###
POST http://127.0.0.1:8000/fitwise/signup/
Content-Type: application/json

{

    "username":"user1",
    "email":"djangouser@gmail.com",
    "password":"user123"
}


#api call for creating a token 

###
POST http://127.0.0.1:8000/fitwise/token/
Content-Type: application/json

{
    "username":"user1",
    "password":"user123"

}


#api call for listing the user 

###
GET http://127.0.0.1:8000/fitwise/me/
Accept: application/json
Authorization: Token 0d51985394852f7143abf7a3b06cd10a0c99f43a 

# =========  foodlogs endpoints ==========

#api call for listing the foodlogs of user1
###
GET http://127.0.0.1:8000/fitwise/foodlogs/
Accept: application/json
Authorization: Token 0d51985394852f7143abf7a3b06cd10a0c99f43a

#api call for creating a foodlog 

###
POST http://127.0.0.1:8000/fitwise/foodlogs/
Content-Type: application/json
Authorization: Token 0d51985394852f7143abf7a3b06cd10a0c99f43a

{
    "title": "Chicken Shawarma",
    "calorie": 360,
    "meal_type": "DINNER",
    "serving_size": "Medium"
}

#api call for fetching a foodlog
###
GET http://127.0.0.1:8000/fitwise/foodlogs/4/
Accept: application/json
Authorization: Token 0d51985394852f7143abf7a3b06cd10a0c99f43a

#api call for updating a foodlog
###
PUT http://127.0.0.1:8000/fitwise/foodlogs/1/
Content-Type: application/json
Authorization: Token 0d51985394852f7143abf7a3b06cd10a0c99f43a

{
  "id": 1,
    "title": "Chicken Biriyani",
    "calorie": 450,
    "meal_type": "LUNCH",
  "serving_size": "1 plate",
  "created_at": "2026-10-11T06:51:18.064900Z",
  "updated_at": "2026-10-11T06:51:18.064900Z",
  "owner": 2
}

#api call for deleting a foodlog 

###
DELETE http://127.0.0.1:8000/fitwise/foodlogs/2/
Accept: application/json
Authorization: Token 0d51985394852f7143abf7a3b06cd10a0c99f43a

#api call for taking foodlog summary

###
GET http://127.0.0.1:8000/fitwise/foodlog/summary/
Accept: application/json
Authorization: Token 0d51985394852f7143abf7a3b06cd10a0c99f43a

#api call for dietplan 

###
GET http://127.0.0.1:8000/fitwise/foodlog/dietplan/
Accept: application/json
Authorization: Token 0d51985394852f7143abf7a3b06cd10a0c99f43a